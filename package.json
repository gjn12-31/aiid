{
  "name": "behind-the-mystery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:live": "node --env-file=.env.local --conditions=react-server --import tsx scripts/check-host.ts",
    "test:generation": "node --env-file=.env.local --conditions=react-server --import tsx scripts/check-generation.ts",
    "dev:poll": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/pirata-one": "5.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
